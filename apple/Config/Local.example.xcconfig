// Copy to Local.xcconfig (gitignored) to install on a phone or iPad.
BUNDLE_ID_PREFIX = com.example
DEVELOPMENT_TEAM = ABCDE12345
// The same value as NUTRIDEX_UPLOAD_TOKEN in the server's .env.local.
NUTRIDEX_UPLOAD_TOKEN = choose-a-long-random-value
