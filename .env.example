# Copy to .env.local and fill in. .env.local is never committed.

# Postgres. Local cluster from `npm run db:local`. `docs/DEVELOPMENT.md` "Going live" covers Supabase.
DATABASE_URL=postgres://localhost:54329/foodi_dex

# What `npm run test:db` runs against; `npm run db:test` creates and seeds it. Never the one above.
TEST_DATABASE_URL=postgres://localhost:54329/foodi_dex_test

# USDA FoodData Central key: https://fdc.nal.usda.gov/api-key-signup/
USDA_API_KEY=

# Claude API, for Phase 5 (Ingest).
ANTHROPIC_API_KEY=

# Sign-in on the web (docs/DEVELOPMENT.md "Accounts"). With either missing, the site runs without accounts.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# The secret the native apps send to upload encounters. With none set, the server refuses all of them.
NUTRIDEX_UPLOAD_TOKEN=
