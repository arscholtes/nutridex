# Copy to .env.local and fill in. .env.local is never committed.

# Postgres. Local cluster from `npm run db:local`, later the Supabase connection string.
DATABASE_URL=postgres://localhost:54329/foodi_dex

# USDA FoodData Central key: https://fdc.nal.usda.gov/api-key-signup/
USDA_API_KEY=

# Claude API, for Phase 5 (Ingest).
ANTHROPIC_API_KEY=
