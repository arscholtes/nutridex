{
  "name": "foodi-dex",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:local": "bash scripts/db-local.sh",
    "db:test": "bash scripts/db-test.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "seed": "node --env-file=.env.local scripts/seed.ts",
    "generate:foods": "node --env-file=.env.local scripts/generate-usda-foods.ts",
    "seed:foods": "node --env-file=.env.local scripts/seed-foods.ts",
    "export:native": "node --env-file=.env.local scripts/export-native.ts",
    "creatures:map": "node scripts/creature-mapping.ts",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "epistasis": "0.1.0",
    "next": "^16.4.3",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
